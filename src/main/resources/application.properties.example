# Copie este arquivo para application.properties e preencha com os dados do SEU MySQL.
# O application.properties real NAO vai para o Git (esta no .gitignore).
spring.datasource.url=jdbc:mysql://localhost:3306/gestao_operacional?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
spring.datasource.username=SEU_USUARIO_AQUI
spring.datasource.password=SUA_SENHA_AQUI
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
